name: Build Post-XP (XP64, Vista, 7, 8, 10 & 11)

on:
  push:
    branches: [ "**" ]
  pull_request:
    branches: [ "**" ]
  workflow_dispatch:

jobs:
  post-xp-modern:
    runs-on: windows-latest
    defaults:
      run:
        shell: cmd

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Prepare dist directory
        run: if not exist dist mkdir dist

      - name: 1. Build Windows XP 64-bit (XP64 - MSVC x64, after XP32)
        id: build_xp64
        continue-on-error: true
        run: |
          for /f "tokens=*" %%I in ('"C:\Program Files (x86)\Microsoft Visual Studio\Installer\vswhere.exe" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath') do set "VSDIR=%%I"
          call "%VSDIR%\Common7\Tools\VsDevCmd.bat" -arch=x64 -host_arch=x64
          cl /nologo /O2 /D_WIN32_WINNT=0x0502 /DBGC_VAULT_KEY=0x13572468u bgc.c /Fe:dist\bgc_xp64.exe /link gdi32.lib winmm.lib user32.lib ws2_32.lib

      - name: 2. Build Windows Vista (NT 6.0 - x64)
        id: build_vista
        continue-on-error: true
        run: |
          for /f "tokens=*" %%I in ('"C:\Program Files (x86)\Microsoft Visual Studio\Installer\vswhere.exe" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath') do set "VSDIR=%%I"
          call "%VSDIR%\Common7\Tools\VsDevCmd.bat" -arch=x64 -host_arch=x64
          cl /nologo /O2 /D_WIN32_WINNT=0x0600 /DBGC_VAULT_KEY=0x13572468u bgc.c /Fe:dist\bgc_vista.exe /link gdi32.lib winmm.lib user32.lib ws2_32.lib

      - name: 3. Build Windows 7 (NT 6.1 - x64)
        id: build_win7
        continue-on-error: true
        run: |
          for /f "tokens=*" %%I in ('"C:\Program Files (x86)\Microsoft Visual Studio\Installer\vswhere.exe" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath') do set "VSDIR=%%I"
          call "%VSDIR%\Common7\Tools\VsDevCmd.bat" -arch=x64 -host_arch=x64
          cl /nologo /O2 /D_WIN32_WINNT=0x0601 /DBGC_VAULT_KEY=0x13572468u bgc.c /Fe:dist\bgc_win7.exe /link gdi32.lib winmm.lib user32.lib ws2_32.lib

      - name: 4. Build Windows 8 / 8.1 (NT 6.2 / 6.3 - x64)
        id: build_win8
        continue-on-error: true
        run: |
          for /f "tokens=*" %%I in ('"C:\Program Files (x86)\Microsoft Visual Studio\Installer\vswhere.exe" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath') do set "VSDIR=%%I"
          call "%VSDIR%\Common7\Tools\VsDevCmd.bat" -arch=x64 -host_arch=x64
          cl /nologo /O2 /D_WIN32_WINNT=0x0603 /DBGC_VAULT_KEY=0x13572468u bgc.c /Fe:dist\bgc_win8.exe /link gdi32.lib winmm.lib user32.lib ws2_32.lib

      - name: 5. Build Windows 10 & 11 (NT 10.0 - x86 & x64)
        id: build_win10_11
        continue-on-error: true
        run: |
          for /f "tokens=*" %%I in ('"C:\Program Files (x86)\Microsoft Visual Studio\Installer\vswhere.exe" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath') do set "VSDIR=%%I"
          call "%VSDIR%\Common7\Tools\VsDevCmd.bat" -arch=x86 -host_arch=x64
          cl /nologo /O2 /D_WIN32_WINNT=0x0A00 /DBGC_VAULT_KEY=0x13572468u bgc.c /Fe:dist\bgc_win10_11_x86.exe /link gdi32.lib winmm.lib user32.lib ws2_32.lib && ^
          call "%VSDIR%\Common7\Tools\VsDevCmd.bat" -arch=x64 -host_arch=x64
          cl /nologo /O2 /D_WIN32_WINNT=0x0A00 /DBGC_VAULT_KEY=0x13572468u bgc.c /Fe:dist\bgc_win10_11_x64.exe /link gdi32.lib winmm.lib user32.lib ws2_32.lib

      - name: Upload post-XP & modern artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: bgc-post-xp-modern
          path: dist/*
          if-no-files-found: ignore

      - name: Check overall build status
        if: always()
        run: |
          set "ANY_FAIL=0"
          if not "%build_xp64_outcome%"=="success" set "ANY_FAIL=1"
          if not "%build_vista_outcome%"=="success" set "ANY_FAIL=1"
          if not "%build_win7_outcome%"=="success" set "ANY_FAIL=1"
          if not "%build_win8_outcome%"=="success" set "ANY_FAIL=1"
          if not "%build_win10_11_outcome%"=="success" set "ANY_FAIL=1"
          if "%ANY_FAIL%"=="1" (
            echo Some post-XP targets failed; prior successful builds were uploaded to bgc-post-xp-modern.
            exit /b 1
          )
